{
  "name": "papertrail",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "npm run test:unit && npm run test:reader",
    "test:unit": "node --experimental-strip-types --test src/features/*/*.test.mjs",
    "test:reader": "vitest run",
    "build:reader": "tsc --project tests/reader/tsconfig.json && vite build --config tests/reader/vite.config.ts --outDir dist/reader-checks"
  },
  "dependencies": {
    "@atproto/oauth-client-browser": "^0.5.14",
    "@atproto/syntax": "^0.7.7",
    "pdfjs-dist": "6.5.438",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-pdf": "11.1.0",
    "react-router": "^7.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^31.0.1",
    "typescript": "~6.0.0",
    "vite": "^8.0.0",
    "vitest": "^5.1.1"
  }
}
